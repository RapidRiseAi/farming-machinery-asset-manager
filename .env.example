# ─────────────────────────────────────────────────────────────
# Copy to .env.local and fill in. NEVER commit real values.
# ─────────────────────────────────────────────────────────────

# Supabase dev project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret. Used ONLY by service-role server routes
# (public QR submit endpoints, admin operations). NEVER exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# App config
NEXT_PUBLIC_APP_NAME=FleetWise
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Nightly cron secret. The /api/cron/nightly route requires
# `Authorization: Bearer ${CRON_SECRET}`. When set in the Vercel project, Vercel Cron
# sends this header automatically. Generate a long random value (e.g. `openssl rand -hex 32`).
# See docs/CRON.md.
CRON_SECRET=

# ─────────────────────────────────────────────────────────────
# Voice assistant (Azure Speech in South Africa North + optional Vercel AI Gateway)
# Server-only: never prefix these with NEXT_PUBLIC_ and never expose the Azure key.
# The browser receives a short-lived Speech token from FleetWise's authenticated broker.
# ─────────────────────────────────────────────────────────────
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southafricanorth
AZURE_SPEECH_ENDPOINT=https://southafricanorth.api.cognitive.microsoft.com/
# Used only when deterministic EN/AF parsing cannot resolve a request and the user has
# explicitly consented to cross-border AI processing.
LLM_MODEL=openai/gpt-5.4-mini
# Vercel supplies Gateway authentication through OIDC in deployments. Local OIDC tokens
# expire after 12 hours. Pull to a temporary ignored file and merge ONLY its
# VERCEL_OIDC_TOKEN into your existing .env.local; a direct pull to .env.local would
# overwrite locally managed secrets, while Preview/Production Sensitive values export as
# [SENSITIVE]. Never commit either file.

# ─────────────────────────────────────────────────────────────
# Web Push (F6) — self-hosted VAPID, no external provider.
# Generate a keypair with:  node scripts/gen-vapid-keys.mjs
# If these are UNSET, push simply no-ops (in-app alerts still work).
# ─────────────────────────────────────────────────────────────
# Server-only signing keys (never exposed to the browser).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI the push service can reach you at (mailto: or https:).
VAPID_SUBJECT=mailto:alerts@example.com
# Same value as VAPID_PUBLIC_KEY, exposed to the browser so it can subscribe.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ─────────────────────────────────────────────────────────────
# Local RLS test database (used by supabase/tests/run.sh only —
# this is NOT the application database).
#
# The harness takes a database NAME, not a URL, and reaches the cluster through the
# ordinary libpq variables. It previously documented TEST_DATABASE_URL, which run.sh has
# never read — anyone following it set a variable that did nothing and then wondered why
# the suite ran somewhere else.
#
# Give each concurrent run its own name: run.sh DROPS and recreates the database it is
# pointed at, so two runs sharing a name will destroy each other mid-suite.
# ─────────────────────────────────────────────────────────────
TEST_DB_NAME=farmapp_test
# Standard libpq settings for reaching that cluster. On Windows PGCLIENTENCODING=UTF8 is
# not optional: without it the em-dashes in this codebase load as mojibake and show up
# later as functions that differ from the repo for no visible reason (docs/SCHEMA_DRIFT.md).
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGCLIENTENCODING=UTF8

# ── Email (Resend) ─────────────────────────────────────────────────
# Sending quotes, invoices, credit notes and statements to customers. Optional:
# with RESEND_API_KEY unset the send button reports that email is not switched on
# rather than silently doing nothing, and everything else works unchanged.
RESEND_API_KEY=
# The verified sender. Resend will only accept a domain you own; the partner's own
# address goes on Reply-To, so a customer replying reaches them, not us.
EMAIL_FROM=documents@fleetwise.app

# ── Online customer-invoice payment (G10) — intentionally disabled ─
# Current product decision: FleetWise does not sit between contractors and their
# customers' money. Keep PAYMENTS_PROVIDER unset; customers pay contractors through
# their normal channels and contractors record payments manually. The dormant adapter
# remains only as a future seam if this feature is explicitly requested later.
# When enabled in a future phase, this would let a customer pay an invoice by card/EFT.
# Unset, the "pay now" button is simply not offered and everything else works unchanged —
# a partner recording payments by hand is not affected either way.
#
# PAYMENTS_PROVIDER=payfast turns it on; the merchant credentials come from the PayFast
# dashboard. PAYFAST_PASSPHRASE is optional but strongly recommended (set it in PayFast's
# security settings first — the signature must match, so an empty value here with one set
# there rejects every payment).
PAYMENTS_PROVIDER=
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# 1 = use PayFast's sandbox rather than live. Test here first: the ITN callback cannot be
# exercised without a real payment going through their servers.
PAYFAST_SANDBOX=

# ── Error reporting (NFR-6) ───────────────────────────────────────────────────
#
# Optional. Leave blank and errors go to the server log, which Vercel already collects —
# the app behaves identically either way.
#
# Set it to a Sentry DSN (https://<key>@<host>/<project>) and server errors, server-action
# failures and browser error boundaries all report there. We speak the ingest protocol over
# fetch rather than installing @sentry/nextjs, so this adds ZERO bytes to the client bundle,
# which has been held at 102 kB for the whole project. The trade: no session replay, no
# performance traces, and no source-map symbolication unless maps are uploaded separately.
#
# User ids and farm ids are sent as opaque uuids so one farm's outage can be told apart from
# a general one. Names, emails, phone numbers, row content and query strings are never sent.
SENTRY_DSN=

# ── FleetWise SaaS subscription billing (Paystack) ────────────────────────────
#
# This is FARMS PAYING RAPID RISE for the software. It is NOT the money that moves
# between a farm and its contractors — that is the dormant PayFast seam above
# (PAYMENTS_PROVIDER), which stays unset and inert. The two never meet.
#
# TWO-PART SAFETY SWITCH. Both must be on before a single rand can move:
#
#   BILLING_PROVIDER=paystack       turns the adapter on. Webhooks are verified and
#                                   payments RECONCILED, but nothing new is charged.
#   BILLING_CHARGING_ENABLED=true   additionally permits NEW charges.
#
# Leaving the first blank resolves to the no-op adapter, which is the current intended
# state: plans and entitlements are fully enforced and nothing charges anyone. Leaving
# the SECOND off while the first is on is the deliberate resting state for production
# until the founder switches charging on — and it is also the ROLLBACK: turn charging
# off and the ledger keeps reconciling money already in flight, rather than being
# deleted. Missing configuration never breaks the rest of FleetWise; the adapter reads
# every value lazily and fails closed.
BILLING_PROVIDER=
BILLING_CHARGING_ENABLED=

# Server only. NEVER prefix with NEXT_PUBLIC_ and never log it. Paystack signs the
# webhook (x-paystack-signature, HMAC-SHA512) with this SAME key — there is no separate
# webhook secret to copy. The hosted-checkout flow used here needs no public key in the
# browser, so none is listed.
PAYSTACK_SECRET_KEY=

# Rapid Rise's own VAT number, printed on the invoices we issue to farms. Leave BLANK
# while not VAT-registered: a database trigger then forces the rate to zero, no VAT line
# is shown, and the document is correctly NOT headed "Tax invoice" (VAT Act s20(4)).
# Registering later is a flag flip in billing_settings and restates no past invoice.
FLEETWISE_VAT_NUMBER=

# Billing reuses NEXT_PUBLIC_SITE_URL (above) for every callback URL — never the Host
# header — and CRON_SECRET (above) for /api/cron/billing, which is deliberately separate
# from /api/cron/nightly so a billing failure cannot disrupt maintenance jobs.
