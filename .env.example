# ─────────────────────────────────────────────────────────────
# Copy to .env.local and fill in. NEVER commit real values.
# ─────────────────────────────────────────────────────────────

# Supabase dev project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret. Used ONLY by service-role server routes
# (public QR submit endpoints, admin operations). NEVER exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# App config
NEXT_PUBLIC_APP_NAME=FleetWise
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Nightly cron secret. The /api/cron/nightly route requires
# `Authorization: Bearer ${CRON_SECRET}`. When set in the Vercel project, Vercel Cron
# sends this header automatically. Generate a long random value (e.g. `openssl rand -hex 32`).
# See docs/CRON.md.
CRON_SECRET=

# ─────────────────────────────────────────────────────────────
# Voice assistant (Azure Speech in South Africa North + optional Vercel AI Gateway)
# Server-only: never prefix these with NEXT_PUBLIC_ and never expose the Azure key.
# The browser receives a short-lived Speech token from FleetWise's authenticated broker.
# ─────────────────────────────────────────────────────────────
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southafricanorth
AZURE_SPEECH_ENDPOINT=https://southafricanorth.api.cognitive.microsoft.com/
# Used only when deterministic EN/AF parsing cannot resolve a request and the user has
# explicitly consented to cross-border AI processing.
LLM_MODEL=openai/gpt-5.4-mini
# Vercel supplies Gateway authentication through OIDC in deployments. For local work,
# run `vercel env pull .env.local` to obtain a short-lived VERCEL_OIDC_TOKEN; do not copy
# that rotating token into this example or commit it.

# ─────────────────────────────────────────────────────────────
# Web Push (F6) — self-hosted VAPID, no external provider.
# Generate a keypair with:  node scripts/gen-vapid-keys.mjs
# If these are UNSET, push simply no-ops (in-app alerts still work).
# ─────────────────────────────────────────────────────────────
# Server-only signing keys (never exposed to the browser).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI the push service can reach you at (mailto: or https:).
VAPID_SUBJECT=mailto:alerts@example.com
# Same value as VAPID_PUBLIC_KEY, exposed to the browser so it can subscribe.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ─────────────────────────────────────────────────────────────
# Local RLS test database (used by supabase/tests/run.sh only —
# this is NOT the application database).
# ─────────────────────────────────────────────────────────────
TEST_DATABASE_URL=postgresql://postgres@localhost:5432/farmapp_test

# ── Email (Resend) ─────────────────────────────────────────────────
# Sending quotes, invoices, credit notes and statements to customers. Optional:
# with RESEND_API_KEY unset the send button reports that email is not switched on
# rather than silently doing nothing, and everything else works unchanged.
RESEND_API_KEY=
# The verified sender. Resend will only accept a domain you own; the partner's own
# address goes on Reply-To, so a customer replying reaches them, not us.
EMAIL_FROM=documents@fleetwise.app

# ── Online customer-invoice payment (G10) — intentionally disabled ─
# Current product decision: FleetWise does not sit between contractors and their
# customers' money. Keep PAYMENTS_PROVIDER unset; customers pay contractors through
# their normal channels and contractors record payments manually. The dormant adapter
# remains only as a future seam if this feature is explicitly requested later.
# When enabled in a future phase, this would let a customer pay an invoice by card/EFT.
# Unset, the "pay now" button is simply not offered and everything else works unchanged —
# a partner recording payments by hand is not affected either way.
#
# PAYMENTS_PROVIDER=payfast turns it on; the merchant credentials come from the PayFast
# dashboard. PAYFAST_PASSPHRASE is optional but strongly recommended (set it in PayFast's
# security settings first — the signature must match, so an empty value here with one set
# there rejects every payment).
PAYMENTS_PROVIDER=
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# 1 = use PayFast's sandbox rather than live. Test here first: the ITN callback cannot be
# exercised without a real payment going through their servers.
PAYFAST_SANDBOX=
