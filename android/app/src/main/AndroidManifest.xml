<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      FLEETWISE Android app (task B6, docs/ANDROID.md).
      Backups are off: the device holds a signed-in session and positions waiting to be sent,
      which must not be restored onto another phone or into another person's account (POPIA).
    -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme"
        tools:targetApi="31">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              App Links: the app's own https links (emailed sign-in, invite and reset links) open in
              the app once https://<host>/.well-known/assetlinks.json names this app's signing key
              (ANDROID_CERT_SHA256 on the server). Until then they open in the browser as before.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${appLinkHost}" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!--
          The background-geolocation plugin's foreground service (type location) records a drive
          the person started. The plugin declares it exported; nothing outside this app may start
          or bind it.
        -->
        <service
            android:name="com.equimaps.capacitor_background_geolocation.BackgroundGeolocationService"
            android:exported="false"
            android:foregroundServiceType="location"
            tools:replace="android:exported" />
    </application>

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Voice notes and spoken commands record from the microphone, only while the person holds the button. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!--
      Location while recording a drive comes from the plugin: ACCESS_FINE_LOCATION,
      ACCESS_COARSE_LOCATION, FOREGROUND_SERVICE, FOREGROUND_SERVICE_LOCATION and
      POST_NOTIFICATIONS. ACCESS_BACKGROUND_LOCATION is NOT requested: recording runs only in a
      foreground service the person starts while the app is open (docs/ANDROID.md, Play policy).
    -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" tools:node="remove" />

    <!-- Not every phone or tablet has GPS or a microphone: the app installs without them. -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" tools:replace="android:required" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
